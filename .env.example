# ============================================
# 前端配置 (WeComer-Fonted)
# ============================================
VITE_BASE_URL=http://localhost:8080

# ============================================
# 后端配置 (ai-server / Spring Boot)
# ============================================
# 数据库配置
DB_URL=jdbc:mysql://127.0.0.1:3306/ai-server?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百川 API 配置
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen-max

# 服务配置
SERVER_PORT=8080
APP_NAME=ai-server